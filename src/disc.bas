10 MODE 1:BORDER 0:INK 0,0:INK 1,18:INK 2,8:INK 3,26:DEG:RANDOMIZE 7
20 MEMORY &87FF
30 ' the sun, in stripes, sinking behind the horizon
40 FOR y=6 TO 90 STEP 7:w=SQR(8100-y*y):MOVE 320-w,200+y:DRAW 320+w,200+y,2:NEXT
50 ' wireframe mountains
60 MOVE 0,200:FOR x=0 TO 640 STEP 40:READ h:DRAW x,200+h,1:NEXT
70 DATA 0,40,18,62,30,84,44,20,4,12,36,70,26,56,14,38,0
80 ' the floor runs off to the horizon
90 FOR i=1 TO 9:y=200-200*i*i/81:MOVE 0,y:DRAW 639,y,2:NEXT
100 FOR j=-12 TO 12:MOVE 320+j*14,200:DRAW 320+j*120,0,2:NEXT
110 ' stars
120 FOR i=1 TO 60:x=RND*640:y=214+RND*170
130 IF ABS(x-320)>100 OR y>300 THEN PLOT x,y,3
140 NEXT
150 ' The Line: hills and a gap
160 MOVE 0,110:READ n:FOR i=1 TO n:READ x,y,p:IF p=0 THEN MOVE x,y ELSE DRAW x,y,p
170 NEXT
180 DATA 9,110,110,1,140,140,1,250,140,1,280,110,1,390,110,1,430,110,0,520,110,1,560,130,1,640,130,1
190 ' Linner: a circle and his rebellious ray
200 cx=196:cy=161:r=20:MOVE cx+r,cy:FOR a=15 TO 360 STEP 15:DRAW cx+r*COS(a),cy+r*SIN(a),1:NEXT
210 MOVE cx,cy:DRAW cx+17*COS(250),cy+17*SIN(250),1:MOVE cx+24*COS(20),cy+24*SIN(20):DRAW cx+32*COS(20),cy+32*SIN(20),3
220 ' shots on their way to a Triangle
230 FOR i=2 TO 6:MOVE cx+34*i*COS(20),cy+34*i*SIN(20):DRAWR 8*COS(20),8*SIN(20),3:NEXT
240 MOVE 395,226:DRAWR 15,26,3:DRAWR 15,-26:DRAWR -30,0
250 ' a Rectangle on the Line, a Rhombus in the air
260 MOVE 584,130:DRAWR 0,24,3:DRAWR 32,0:DRAWR 0,-24:DRAWR -32,0
270 MOVE 88,150:DRAWR 12,17,3:DRAWR -12,17:DRAWR -12,-17:DRAWR 12,-17
280 ' words, drawn over the picture
290 PRINT CHR$(22);CHR$(1);
300 PEN 1:LOCATE 13,2:PRINT "L  I  N  N  E  R"
310 PEN 3:LOCATE 9,4:PRINT "Roll fast. Shoot sharp."
320 LOCATE 12,5:PRINT "Stay well-rounded."
330 PEN 3:LOCATE 16,25:PRINT "Loading...";
340 LOAD"LOADER.BIN",&9000
350 CALL &9000
