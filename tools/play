#!/usr/bin/env bash
# Play Linner interactively.
#   tools/play [caprice32|cpcemu] [file.sna|file.dsk]
# (default: caprice32, build/linner.sna). Booting a .dsk: type RUN"DISC
set -euo pipefail
cd "$(dirname "$0")/.."
EMU="${1:-caprice32}"
FILE="$(realpath "${2:-build/linner.sna}")"
case "$EMU" in
  cpcemu)    cd /usr/share/cpcemu && exec ./cpcemu -t 2 "$FILE" ;;
  caprice32)
    if [[ "$FILE" == *.dsk ]]; then
      exec snap run caprice32.launcher -a $'run"disc\n' "$FILE"
    fi
    exec snap run caprice32.launcher "$FILE" ;;
  *) echo "usage: tools/play [caprice32|cpcemu] [file.sna|file.dsk]" >&2; exit 2 ;;
esac
